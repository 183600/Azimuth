// 用户添加的 MoonBit 测试用例 - 使用标准语法
test "user_standard_add_test" {
  2 + 3 = 5
}

test "user_standard_subtract_test" {
  10 - 3 = 7
}

test "user_standard_multiply_test" {
  4 * 5 = 20
}

test "user_standard_greet_test" {
  greet("World") = "Hello, World!"
}

test "user_standard_divide_with_ceil_test" {
  divide_with_ceil(10, 3) = 4
}