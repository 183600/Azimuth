        Some as *Some/67 => {
          let *y/68 : String = *Some/67.0
          let y/7 : String = *y/68
          let x/6 : Int = *x/66
          x/6 + @stringlength(y/7)
        }
        _ => *x/66
      }
    }
    _ => match some_str/5 {
      Some as *Some/63 => {
        let *y/64 : String = *Some/63.0
        let y/9 : String = *y/64
        @stringlength(y/9)
