fn __test_7374616e646172645f6d6f6f6e6269745f746573745f63617365732e6d6274_3 ()
  -> Unit raise InspectError {
  let empty/20 : String = ""
  let hello/21 : String = "Hello"
  let world/22 : String = "World"
  let greeting/23 : String = @ccall add_string(
    @ccall add_string(@ccall add_string(hello/21, ", "), world/22),
    "!"
  )
  $builtin.inspect.inner(
    @stringlength(empty/20)
    as
    &Show,
    "0",
    "@:standard_moonbit_test_cases.mbt:60:3-60:39",
    Array[Option[SourceLoc]]::{
