        None(),
        None()
      ],
      len: 4
    }
  ) catch { err => return_err err }
  $builtin.inspect.inner(
    @stringlength(hello/21)
    as
    &Show,
    "5",
    "@:standard_moonbit_test_cases.mbt:61:3-61:39",
    Array[Option[SourceLoc]]::{
      buf: FixedArray[UnsafeMaybeUninit[Option[SourceLoc]]]::[
        Some("@:standard_moonbit_test_cases.mbt:61:11-61:25"),
        Some("@:standard_moonbit_test_cases.mbt:61:35-61:38"),
        None(),
        None()
      ],
      len: 4
    }
  ) catch { err => return_err err }
  $builtin.inspect.inner(
    greeting/23
    as
    &Show,
    "Hello, World!",
    "@:standard_moonbit_test_cases.mbt:62:3-62:45",
    Array[Option[SourceLoc]]::{
      buf: FixedArray[UnsafeMaybeUninit[Option[SourceLoc]]]::[
        Some("@:standard_moonbit_test_cases.mbt:62:11-62:19"),
        Some("@:standard_moonbit_test_cases.mbt:62:29-62:44"),
        None(),
        None()
      ],
      len: 4
    }
  ) catch { err => return_err err }
  $builtin.inspect.inner(
    @stringlength(greeting/23) > @stringlength(hello/21)
    as
    &Show,
    "true",
    "@:standard_moonbit_test_cases.mbt:63:3-63:62",
    Array[Option[SourceLoc]]::{
